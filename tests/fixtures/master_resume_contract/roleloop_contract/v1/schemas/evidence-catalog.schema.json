{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roleloop.local/schemas/master-resume/evidence-catalog-v1.json",
  "title": "EvidenceCatalogV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract_version",
    "source_revision",
    "resume_id",
    "summary",
    "active_experiences",
    "allowed_skills",
    "active_experience_order",
    "renderer_version",
    "tracked_manifest"
  ],
  "properties": {
    "schema": {"const": "roleloop.evidence-catalog.v1"},
    "contract_version": {"const": 1},
    "source_revision": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "resume_id": {"type": "string", "minLength": 1},
    "summary": {"$ref": "#/$defs/summary"},
    "active_experiences": {
      "type": "array",
      "items": {"$ref": "#/$defs/experience"}
    },
    "allowed_skills": {
      "type": "array",
      "items": {"$ref": "#/$defs/skill"}
    },
    "active_experience_order": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "renderer_version": {"type": "string", "minLength": 1},
    "tracked_manifest": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    }
  },
  "$defs": {
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "source_path", "source_sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "source_path": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "bullet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "experience_id", "project_id", "text", "source_path", "source_sha256"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_.-]+\\.claim\\.[0-9a-f]{16}$"},
        "experience_id": {"type": "string", "minLength": 1},
        "project_id": {"type": ["string", "null"]},
        "text": {"type": "string", "minLength": 1},
        "source_path": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "experience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_path", "source_sha256", "bullets"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source_path": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bullets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/bullet"}}
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "group_id", "group_name"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "group_id": {"type": "string", "minLength": 1},
        "group_name": {"type": "string", "minLength": 1}
      }
    }
  }
}
