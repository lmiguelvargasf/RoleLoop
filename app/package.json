{
  "name": "@roleloop/local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "setup": "tsx scripts/setup.ts && playwright install chromium",
    "doctor": "tsx scripts/doctor.ts",
    "api": "tsx watch src/server/index.ts",
    "worker": "tsx watch src/server/worker.ts",
    "ui": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "tsx scripts/dev.ts --production"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "@supabase/supabase-js": "^2.100.0",
    "cheerio": "^1.2.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.0",
    "fastify": "^5.0.0",
    "lucide-react": "^0.577.0",
    "nodemailer": "^10.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.58.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
