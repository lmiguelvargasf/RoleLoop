# npm run setup generates .env.local with local-only backend credentials.
SUPABASE_URL=http://127.0.0.1:54331
SUPABASE_SERVICE_ROLE_KEY=
API_PORT=4310
APP_URL=http://127.0.0.1:5173
SUPABASE_STUDIO_URL=http://127.0.0.1:54333
MAILPIT_URL=http://127.0.0.1:54334
MAILPIT_HOST=127.0.0.1
MAILPIT_PORT=54335

# Public API key used with each signed-in user session; never the service key.
SUPABASE_ANON_KEY=your-local-anon-key

# Optional hosted résumé extraction and experience-based matching.
# Optional alternative to a ChatGPT connection in Account & access.
# API credentials remain on the server. OpenAI is the only AI provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional free Himalayas REST API key for a dedicated request allowance.
# Create at https://himalayas.app/api. Server only; never use a VITE_ prefix.
# Without a key, automatic company discovery uses the shared public allowance.
HIMALAYAS_API_KEY=
